# DB 접속 정보 예시 파일입니다.
# 이 파일을 같은 폴더에 db.properties 라는 이름으로 복사한 뒤 실제 값을 채우세요.
# db.properties 는 .gitignore 에 들어 있어서 GitHub 에 올라가지 않습니다.
# 운영 서버에서는 파일 대신 환경변수 DB_URL, DB_USERNAME, DB_PASSWORD 를 써도 됩니다.

db.url=jdbc:sqlserver://DB서버주소:25433;DatabaseName=GWS
db.username=DB아이디
db.password=DB비밀번호

# 커넥션 풀 크기 (생략하면 기본값 = 실서버 jar 와 같은 200 / 50)
#db.pool.maxActive=200
#db.pool.maxIdle=50
